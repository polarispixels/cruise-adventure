; Engine configuration file.
; The version below is the single source of truth for the game's version: the
; release this branch is building toward. config/build stays empty here; CI
; stamps it ("playtest 10", "dev 1a2b3c4") so every build shows which one it is.

config_version=5

[application]

config/name="Cruise Adventure"
config/version="0.4.0"
config/build=""
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/icon.png"

[autoload]

Progress="*res://scripts/progress.gd"
Game="*res://scripts/game.gd"
Voice="*res://scripts/voice.gd"
Music="*res://scripts/music.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
